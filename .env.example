# Copy to .env.local for local development. On Vercel, add the same names
# under Project Settings > Environment Variables.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server only. Never prefix this with VITE_: it must not reach the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# A phrase you choose. The app asks for it once, when the first CEO account is created.
FELIX_SETUP_CODE=choose-a-phrase
